# ── dependencies & build output ──
node_modules/
dist/
build/
*.tsbuildinfo

# ── secrets / local config ──
.env
.env.local
.env.*.local
!.env.example

# ── test & coverage ──
coverage/
.nyc_output/

# ── Grafana / Prometheus container state (Day 4) ──
# Provisioning config IS committed; runtime data is not.
coworking-obs/infra/grafana/data/
coworking-obs/infra/prometheus/data/

# ── third-party course material ──
# Pluralsight slide decks are licensed content and ~11 MB of binary. Git keeps
# blobs forever, so committing them can't be cleanly undone later.
plural-sight-resources/

# ── editor & OS ──
.DS_Store
.idea/
*.swp
*.swo

# ── logs ──
*.log
npm-debug.log*
pnpm-debug.log*

# NOTE: deliverables/ is deliberately NOT ignored — screenshots and written
# answers are the graded artifacts and must be committed.
