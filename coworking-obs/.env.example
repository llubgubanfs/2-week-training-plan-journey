# Copy to .env for local dev:  cp .env.example .env
# 12-factor: every value below is read from the environment. Nothing is hardcoded
# in source, so the same image runs locally, in Compose, and on a host if we
# decide to deploy on Day 8.

# ── booking-api ──
BOOKING_API_PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ── notifier (Day 6 downstream service) ──
NOTIFIER_PORT=3001
# booking-api calls the notifier through this URL. In Compose this becomes
# http://notifier:3001 — the service name, not localhost.
NOTIFIER_URL=http://localhost:3001

# ── Postgres (Day 4 onward) ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=coworking
POSTGRES_PASSWORD=coworking
POSTGRES_DB=coworking

# ── OpenTelemetry (Day 6) ──
# Collector endpoint. In Compose: http://jaeger:4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER=parentbased_always_on
