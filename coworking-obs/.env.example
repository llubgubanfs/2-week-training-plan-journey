# Copy to .env for local dev:  cp .env.example .env
# 12-factor: every value below is read from the environment. Nothing is hardcoded
# in source, so the same image runs locally, in Compose, and on a host if we
# decide to deploy on Day 8.

# ── booking-api ──
BOOKING_API_PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Local-dev readability only. Leave unset (or false) everywhere else — anything
# that ships emits one JSON object per line for Loki to parse.
LOG_PRETTY=false

# ── notifier (Day 6 downstream service) ──
NOTIFIER_PORT=3001
# booking-api calls the notifier through this URL. In Compose this becomes
# http://notifier:3001 — the service name, not localhost.
NOTIFIER_URL=http://localhost:3001

# ── Postgres (Day 4 onward) ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=coworking
POSTGRES_PASSWORD=coworking
POSTGRES_DB=coworking

# ── Expiry sweep (Day 8) ──
# The scheduled job that releases expired bookings. Deliberately flawed so the
# silent-failure instrumentation has something to detect.
SWEEP_INTERVAL_MS=15000
# none | throw | silent | mixed
#   throw  — loud: an exception escapes, outcome="failure", error log written
#   silent — the interesting one: runs, matches nothing, returns success
#   mixed  — alternates, so one demo produces both shapes
SWEEP_FAILURE_MODE=mixed
SWEEP_FAILURE_RATE_PCT=20
# Synthetic bookings created per tick, so the invariant has something to break.
SWEEP_SEED_PER_TICK=3
BOOKING_TTL_MS=20000

# ── OpenTelemetry (Day 6) ──
# Collector endpoint. In Compose: http://jaeger:4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER=parentbased_always_on
